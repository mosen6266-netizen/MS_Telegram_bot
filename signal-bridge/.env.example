# This service is deliberately independent of the production Telegram Worker.
# Node.js 22+ can load it with: node --env-file=.env server.mjs
SIGNAL_ENABLED=false
SIGNAL_DRY_RUN=true
SIGNAL_ENABLE_RECEIVE=false
SIGNAL_BRIDGE_PORT=8789
SIGNAL_STATE_PATH=./data/state.json
SIGNAL_CLI_RPC_URL=http://127.0.0.1:8080
SIGNAL_ACCOUNT=
# Raw signal-cli group IDs, comma-separated. Never insert Telegram chat IDs.
SIGNAL_GROUP_IDS=
# Generate your own random >=32-character secret. Do not commit the real value.
SIGNAL_BRIDGE_TOKEN=
# Separate 32+ character secret for the local Signal management panel; never reuse Telegram credentials.
SIGNAL_ADMIN_TOKEN=
# Optional: HTTPS read-only Signal-specific query adapter, NOT production Telegram admin/API.
SIGNAL_QUERY_URL=
SIGNAL_QUERY_TOKEN=
